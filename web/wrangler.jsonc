{
  // A self-hosted TwigAnimate web build. No upstream custom domain or release destination is configured.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "twiganimate",
  "compatibility_date": "2026-09-10",
  "workers_dev": true,
  "assets": {
    "directory": "../build/web",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  },
  "observability": { "enabled": false }
}
